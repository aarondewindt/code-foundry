 export function clamp(value, min, max) {
+  // Validate range bounds
+  if (min > max) {
+    throw new RangeError('min must not exceed max');
+  }
+  // Clamp the value to the [min, max] range
+  if (value < min) return min;
+  if (value > max) return max;
   return value;
 }
