{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/local",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "enabled_providers": ["ollama"],
  "small_model": "ollama/local",
  "provider": {
    "ollama": {
      "name": "Desktop Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OLLAMA_HOST}/v1",
        "timeout": 120000
      },
      "models": {
        "local": {
          "id": "{env:OLLAMA_MODEL}",
          "name": "Selected local model",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": {
      "*": "deny",
      "node --test*": "allow"
    }
  }
}
