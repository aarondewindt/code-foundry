{
  "name": "code-foundry",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI development automation with OpenCode and Ollama",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "yarn@4.18.1",
  "bin": "dist/cli.js",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:smoke": "python3 tools/integration/vm.py --smoke",
    "test:integration": "python3 tools/integration/vm.py",
    "check:integration": "yarn check && yarn test:integration",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
